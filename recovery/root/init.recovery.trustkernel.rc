# TrustKernel TEE for Qin F25 Pro (mt6768) - needed for FBE decrypt in TWRP.
# Adapted from stock /vendor/etc/init/trustkernel.rc: writable tkcore paths moved
# to recovery tmpfs since /data is still encrypted when teed starts.

on fs
    # rpmb device nodes for tkcore
    chmod 0660 /dev/rpmb0
    chown system system /dev/rpmb0
    chmod 0660 /dev/mmcblk0rpmb
    chown system system /dev/mmcblk0rpmb

on post-fs
    write /proc/bootprof "tkcore: prepare recovery ta paths"
    mkdir /tmp/t6 0755 system system
    mkdir /tmp/t6/fs 0755 system system
    mkdir /tmp/t6/app 0755 system system

    # tkcore protected storage lives on protect_f
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/protect_f 0771 system system
    mount ext4 /dev/block/platform/bootdevice/by-name/protect1 /mnt/vendor/protect_f noatime nosuid nodev
    mkdir /mnt/vendor/protect_f/tee 0770 system system

    start teed

on property:vendor.trustkernel.ready=true
    start vendor.keymaster-4-1-trustkernel
    start vendor.gatekeeper-1-0

service teed /vendor/bin/teed \
    --datapath /tmp/t6/fs \
    --sptapath /tmp/t6/app \
    --systapath /vendor/app/t6 \
    --rpmbdev /dev/mmcblk0rpmb \
    --rpmbdev /dev/rpmb0 \
    --prot /mnt/vendor/protect_f/tee \
    --prebuilt /vendor/app/t6/data \
    --logpath /tmp/t6/tkcore.log \
    --proprefix vendor.trustkernel
    capabilities SYS_RAWIO
    user system
    group system
    class core
    disabled
    seclabel u:r:recovery:s0

service vendor.keymaster-4-1-trustkernel /vendor/bin/hw/android.hardware.keymaster@4.1-service.trustkernel
    class core
    user system
    group system drmrpc
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class core
    user system
    group system
    disabled
    seclabel u:r:recovery:s0
