diff --git a/libtar/libtar.h b/libtar/libtar.h
index f42b201..7adec46 100755
--- a/libtar/libtar.h
+++ b/libtar/libtar.h
@@ -21,7 +21,48 @@
 #include "libtar_listhash.h"
 
 #ifdef USE_FSCRYPT
+#include <stdbool.h>
 #include "fscrypt_policy.h"
+
+/* Compat with android-14.1 system/vold, which dropped the fscrypt_policy
+ * union and its accessor helpers. The policy version is fixed at build
+ * time (USE_FSCRYPT_POLICY_V1/V2), so alias the concrete kernel struct
+ * and provide the old accessors as inlines. */
+#undef fscrypt_policy
+#ifdef USE_FSCRYPT_POLICY_V1
+typedef struct fscrypt_policy_v1 fscrypt_policy;
+#define TWRP_FSCRYPT_POLICY_SIZE FS_KEY_DESCRIPTOR_SIZE
+#define TWRP_FSCRYPT_POLICY_SIZE_HEX FS_KEY_DESCRIPTOR_SIZE_HEX
+#define TWRP_FSCRYPT_POLICY_DESCRIPTOR(fep) ((fep)->master_key_descriptor)
+#else
+typedef struct fscrypt_policy_v2 fscrypt_policy;
+#define TWRP_FSCRYPT_POLICY_SIZE FSCRYPT_KEY_IDENTIFIER_SIZE
+#define TWRP_FSCRYPT_POLICY_SIZE_HEX FSCRYPT_KEY_IDENTIFIER_HEX_SIZE
+#define TWRP_FSCRYPT_POLICY_DESCRIPTOR(fep) ((fep)->master_key_identifier)
+#endif
+
+static inline uint8_t* get_policy_descriptor(fscrypt_policy* fep)
+{
+	return fep ? TWRP_FSCRYPT_POLICY_DESCRIPTOR(fep) : NULL;
+}
+
+static inline uint8_t get_policy_size(fscrypt_policy* fep, bool hex)
+{
+	if (!fep)
+		return 0;
+	return hex ? TWRP_FSCRYPT_POLICY_SIZE_HEX : TWRP_FSCRYPT_POLICY_SIZE;
+}
+
+static inline void* get_policy(fscrypt_policy* fep)
+{
+	return (void*)fep;
+}
+
+static inline int fscrypt_policy_size(const fscrypt_policy* fep)
+{
+	(void)fep;
+	return sizeof(fscrypt_policy);
+}
 #endif
 
